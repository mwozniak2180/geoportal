        <mxCell id="fDKmev47iQVT9ePXmguc-85" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;box-sizing: border-box; width: 976.012px; border-collapse: collapse; font-size: 14px; line-height: 1.55; margin: 24px 0px; color: rgb(19, 44, 61); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Model&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Co robi&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Kiedy go rozważyć&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Status w paczce&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Persistence&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Kopiuje ostatnie NDVI/NDMI&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Obowiązkowy punkt odniesienia&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Pełna ocena i możliwość wyboru&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;MLP&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Spłaszcza 8 × 16 i łączy liczby&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Mały, prosty eksperyment&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Trening&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;GRU&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Przenosi pamięć przez tygodnie i steruje jej aktualizacją&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Główny kandydat dla krótkich szeregów&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Trening&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;LSTM&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Ma osobny stan komórki i więcej bramek&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Gdy ważniejsza jest dłuższa historia&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Trening&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;CNN1D&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Szuka lokalnych wzorców w czasie&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Szybkie uczenie zmian i sekwencji&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Trening&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;TCN&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Sploty czasowe z dylatacją i zwykle przyczynową strukturą&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Dłuższe konteksty, wydajne uczenie&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Omówienie; nie nazywamy zwykłego CNN pełnym TCN&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Transformer&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Attention porównuje elementy sekwencji&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Więcej danych, dłuższe/multimodalne szeregi&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Omówienie&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;CNN2D&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Rozpoznaje układy pikseli&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Przestrzenne plamy, brzegi, mozaiki&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Koder + przykład fuzji&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;U-Net&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Nadaje etykietę każdemu pikselowi&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Segmentacja pól/stref z maskami referencyjnymi&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Omówienie; granice już masz&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Autoenkoder&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Odtwarza wejście z kompresji&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Poszukiwanie nietypowych wzorców&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Omówienie; błąd odtworzenia nie jest diagnozą&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Model wstępnie wytrenowany dla EO&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Używa cech poznanych na dużych zbiorach&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Gdy jego pasma i preprocessing pasują do danych&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Dalszy etap&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
