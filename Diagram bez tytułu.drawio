        <mxCell id="fDKmev47iQVT9ePXmguc-82" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;box-sizing: border-box; width: 976.012px; border-collapse: collapse; font-size: 14px; line-height: 1.55; margin: 24px 0px; color: rgb(19, 44, 61); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Objaw&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Prawdopodobny powód&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Pierwszy krok&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Loss=NaN&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;NaN, inf, błędny mianownik, zbyt duży krok&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Sprawdź tensory i jedną paczkę&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Train i val słabe&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Złe etykiety/cechy lub niedouczenie&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Obejrzyj sceny, sprawdź offset i czas&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Train dobre, val słabe&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Przeuczenie albo zmiana rozkładu&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Mniejsza sieć, lepszy podział, więcej sezonów&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Bardzo dobry test po losowym podziale&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Przeciek sąsiednich okien&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Podział czasowy i przestrzenny&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Zaniżanie po siewie, zawyżanie po zbiorze&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Brak kontekstu fazy rozwoju i zabiegów&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Dodaj znane w chwili prognozy informacje&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Wyniki zależą od wieku zdjęcia&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Brak świeżej informacji&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Raportuj wiek, wprowadź odmowę prognozy&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Sieć przegrywa z persistence&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Za mało użytecznej informacji&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Nie zwiększaj automatycznie liczby warstw&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Duży błąd na małych polach&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Piksele mieszane i mała próba&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Ostrzejsza jakość, analiza wnętrza pola&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="470" width="560" x="285" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="fDKmev47iQVT9ePXmguc-83" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;box-sizing: border-box; width: 976.012px; border-collapse: collapse; font-size: 14px; line-height: 1.55; margin: 24px 0px; color: rgb(19, 44, 61); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Parametr&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Start&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Następne rozsądne próby&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Jak interpretować&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;learning_rate&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;0,001&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;0,0003; 0,003&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Za duży: skoki; za mały: bardzo wolna poprawa&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;hidden_size&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;16 lub 32&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;64 po udowodnieniu potrzeby&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Więcej pojemności i ryzyka zapamiętywania&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;dropout&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;0,1&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;0; 0,2&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Utrudnia opieranie się na pojedynczych neuronach&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;weight_decay&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;0,0001&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;0; 0,001&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Ogranicza wzrost wag&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;batch_size&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;32&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;16; 64&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Pamięć, szum gradientu, szybkość&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;lookback&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;8 tygodni&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;4; 12&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Kontekst kontra liczba dostępnych próbek&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;epochs&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;maks. 60&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Zwiększ tylko gdy nadal jest poprawa&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Liczba przejść przez train&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;patience&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;5; 12&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Ile epok bez poprawy walidacji tolerować&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="470" width="560" x="-802" y="1730" as="geometry" />
        </mxCell>
