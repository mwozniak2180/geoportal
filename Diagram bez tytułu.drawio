        </mxCell>
        <mxCell id="fDKmev47iQVT9ePXmguc-86" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table style=&quot;box-sizing: border-box; width: 976.012px; border-collapse: collapse; font-size: 14px; line-height: 1.55; margin: 24px 0px; color: rgb(19, 44, 61); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Problem&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Co robi kod&lt;/th&gt;&lt;th style=&quot;box-sizing: border-box; background: rgb(18, 51, 73); color: white; text-align: left; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Dlaczego&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;box-sizing: border-box;&quot;&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Różne częstotliwości danych&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Jedna siatka tygodniowa&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Meteo i satelita mają wspólną oś czasu&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Chmura&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Obserwacja NaN + maska jakości&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Chmura nie oznacza niskiego NDVI&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Brak satelity w tygodniu&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Przeniesienie ostatniej obserwacji do 2 tygodni&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Operacja korzysta wyłącznie z przeszłości&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Dłuższa luka we wcześniejszej historii&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Mediana z train + wiek obserwacji&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Sieć dostaje skończone wartości i informację o braku&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Brak świeżego pomiaru na końcu okna&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Odrzucenie próbki/odmowa prognozy&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Nie budujemy prognozy na bardzo starej obserwacji&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Brak celu w następnym tygodniu&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Odrzucenie próbki treningowej&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Nie uczymy się na wymyślonej etykiecie&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box;&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Niepełny tydzień meteo&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;NaN dla niepełnej cechy + &lt;code style=&quot;box-sizing: border-box; font: 0.88em ui-monospace, monospace; background: rgb(238, 243, 246); padding: 2px 5px; border-radius: 4px;&quot;&gt;weather_missing&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Suma z 3 dni nie udaje sumy z 7 dni&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;box-sizing: border-box; background: rgb(242, 247, 249);&quot;&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Duplikat&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Błąd lub jawna deduplikacja wcześniej&lt;/td&gt;&lt;td style=&quot;box-sizing: border-box; padding: 11px 12px; border: 1px solid rgb(214, 226, 232);&quot;&gt;Jeden dzień nie dostaje większej wagi&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="470" width="560" x="-4002" y="1740" as="geometry" />
        </mxCell>
